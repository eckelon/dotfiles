{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Installs the local Eclipse dropin (editor fonts + Package Explorer tree).
#
# No compiled artifact is versioned: the sources below are compiled here, so any edit to them
# changes this script and chezmoi reruns it on the next apply. Rebuild by hand with
#   chezmoi execute-template < home/run_onchange_after_install-eclipse-dropin.sh.tmpl | sh
set -e

INSTALL="$HOME/eclipse/java-2026-09/Eclipse.app/Contents/Eclipse"
JAVA="${JAVA:-/Library/Java/JavaVirtualMachines/temurin-27.jdk/Contents/Home/bin}"
VERSION=1.3.0
INFO="$INSTALL/configuration/org.eclipse.equinox.simpleconfigurator/bundles.info"

[ -d "$INSTALL" ] || exit 0
[ -x "$JAVA/javac" ] || { echo "eclipse-dropin: no javac in $JAVA" >&2; exit 0; }

BIN=$(mktemp -d)
OUT=$(mktemp -d)
trap 'rm -rf "$BIN" "$OUT"' EXIT
mkdir -p "$BIN/META-INF" "$BIN/local/expand"

cat > "$BIN/META-INF/MANIFEST.MF" <<'MANIFEST_EOF'
Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Expand Package Explorer
Bundle-SymbolicName: local.expand;singleton:=true
Bundle-Version: 1.3.0
Require-Bundle: org.eclipse.ui,org.eclipse.jdt.ui,org.eclipse.jdt.core,org.eclipse.jface,org.eclipse.swt,org.eclipse.core.runtime,org.eclipse.core.resources,org.eclipse.osgi
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ClassPath: .
MANIFEST_EOF

cat > "$BIN/plugin.xml" <<'PLUGIN_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.startup">
      <startup class="local.expand.ExpandStartup"/>
   </extension>
</plugin>
PLUGIN_EOF

cat > "$BIN/local/expand/ExpandStartup.java" <<'JAVA_EOF'
package local.expand;

import org.eclipse.core.resources.IFile;
import org.eclipse.core.resources.IFolder;
import org.eclipse.core.resources.IProject;
import org.eclipse.core.resources.IResource;
import org.eclipse.core.runtime.IStatus;
import org.eclipse.core.runtime.Platform;
import org.eclipse.core.runtime.Status;
import org.eclipse.jdt.core.ICompilationUnit;
import org.eclipse.jdt.core.IJavaProject;
import org.eclipse.jdt.core.IPackageFragment;
import org.eclipse.jdt.core.JavaModelException;
import org.eclipse.jdt.core.IPackageFragmentRoot;
import org.eclipse.jdt.ui.IPackagesViewPart;
import org.eclipse.jface.preference.IPreferenceStore;
import org.eclipse.jface.preference.PreferenceConverter;
import org.eclipse.jface.resource.JFaceResources;
import org.eclipse.jface.viewers.ITreeContentProvider;
import org.eclipse.jface.viewers.TreeViewer;
import org.eclipse.swt.SWT;
import org.eclipse.swt.graphics.FontData;
import org.eclipse.swt.widgets.Display;
import org.eclipse.ui.IStartup;
import org.eclipse.ui.IViewPart;
import org.eclipse.ui.IWorkbenchPage;
import org.eclipse.ui.IWorkbenchWindow;
import org.eclipse.ui.PlatformUI;
import org.osgi.framework.Bundle;

/** Install-wide tweaks: editor fonts (every workspace) and a predictable Package Explorer tree. */
public class ExpandStartup implements IStartup {
	private static final String VIEW_ID = "org.eclipse.jdt.ui.PackageExplorer";
	private static final String SRC = "src";

	// Same typeface as Ghostty's font-family. SWT has no semibold style, so the Regular face is used.
	private static final FontData FONT = new FontData("JetBrainsMono Nerd Font Mono", 12, SWT.NONE);

	// Everything Eclipse draws itself (dialogs, wizards, banners) uses this fixed size. macOS
	// menus are native NSMenu: no Eclipse setting can touch their font, only the OS can.
	private static final int UI_FONT_HEIGHT = 20;

	private static final String[] UI_FONT_KEYS = {
			"org.eclipse.jface.dialogfont",
			"org.eclipse.jface.bannerfont",
			"org.eclipse.jface.headerfont" };

	private static final String[] FONT_KEYS = {
			"org.eclipse.jface.textfont",
			"org.eclipse.jdt.ui.editors.textfont",
			"org.eclipse.jdt.ui.PropertiesFileEditor.textfont",
			"org.eclipse.debug.ui.consoleFont",
			"org.eclipse.debug.ui.DetailPaneFont",
			"org.eclipse.debug.ui.MemoryViewTableFont",
			"org.eclipse.ui.workbench.texteditor.blockSelectionModeFont",
			"org.eclipse.compare.contentmergeviewer.TextMergeViewer",
			"org.eclipse.jdt.internal.ui.compare.JavaMergeViewer",
			"org.eclipse.jdt.internal.ui.compare.PropertiesFileMergeViewer",
			"org.eclipse.egit.ui.CommitMessageEditorFont",
			"org.eclipse.egit.ui.CommitMessageFont",
			"org.eclipse.egit.ui.DiffHeadlineFont" };

	@Override
	public void earlyStartup() {
		// earlyStartup runs on a background job thread. Everything below touches SWT (the font
		// registry creates Device resources, preference listeners poke StyledText widgets), so it
		// all has to run on the UI thread.
		PlatformUI.getWorkbench().getDisplay().asyncExec(() -> {
			applyFonts();
			Display display = PlatformUI.getWorkbench().getDisplay();
			// Delay so the perspective finishes restoring; retry in case the tree was still empty.
			display.timerExec(3000, () -> expand(1));
			display.timerExec(8000, () -> expand(2));
		});
	}

	private static void applyFonts() {
		try {
			FontData[] fonts = { FONT };
			IPreferenceStore store = PlatformUI.getPreferenceStore();
			for (String key : FONT_KEYS) {
				PreferenceConverter.setValue(store, key, fonts);
			}
			// Registered fonts are cached by the registry; update it so already created viewers follow too.
			JFaceResources.getFontRegistry().put("org.eclipse.jface.textfont", fonts);

			FontData[] uiFonts = uiFont();
			if (uiFonts.length > 0) {
				for (String key : UI_FONT_KEYS) {
					PreferenceConverter.setValue(store, key, uiFonts);
				}
				JFaceResources.getFontRegistry().put("org.eclipse.jface.dialogfont", uiFonts);
			}
			log("fonts set to " + FONT + ", UI fonts " + UI_FONT_HEIGHT + "pt (dialog/banner/header)");
		} catch (Throwable t) {
			log("font update failed: " + t);
		}
	}

	/** The system font family at UI_FONT_HEIGHT, so the change is unmistakable. */
	private static FontData[] uiFont() {
		FontData[] data = PlatformUI.getWorkbench().getDisplay().getSystemFont().getFontData();
		FontData[] scaled = new FontData[data.length];
		for (int i = 0; i < data.length; i++) {
			scaled[i] = new FontData(data[i].getName(), UI_FONT_HEIGHT, data[i].getStyle());
		}
		return scaled;
	}

	private static void expand(int attempt) {
		try {
			IWorkbenchWindow window = PlatformUI.getWorkbench().getActiveWorkbenchWindow();
			if (window == null) {
				return;
			}
			IWorkbenchPage page = window.getActivePage();
			if (page == null) {
				return;
			}
			IViewPart view = page.findView(VIEW_ID);
			if (!(view instanceof IPackagesViewPart packagesView)) {
				log("[attempt " + attempt + "] Package Explorer not found (view=" + view + ")");
				return;
			}
			TreeViewer viewer = packagesView.getTreeViewer();
			if (viewer == null) {
				log("[attempt " + attempt + "] tree viewer is null");
				return;
			}
			boolean found = expandSrcFolders(viewer, viewer.getInput());
			log("[attempt " + attempt + "] src " + (found ? "expanded" : "not found") + ", "
					+ viewer.getExpandedElements().length + " nodes open");
		} catch (Throwable t) {
			log("[attempt " + attempt + "] failed: " + t);
		}
	}

	/**
	 * Opens the branches that lead to a "src" folder and expands that folder down to file level.
	 * Everything else (JRE library, other folders, packages) stays collapsed.
	 */
	private static boolean expandSrcFolders(TreeViewer viewer, Object input) {
		if (input == null || !(viewer.getContentProvider() instanceof ITreeContentProvider provider)) {
			return false;
		}
		boolean found = false;
		Object[] roots = provider.getElements(input);
		for (Object root : roots) {
			found |= revealSrc(viewer, provider, root);
		}
		if (!found) {
			// Diagnostic: what sits at the top, so a missing src can be explained from the log.
			log("no src under input=" + name(input) + " roots=" + describe(provider, roots));
		}
		return found;
	}

	private static boolean revealSrc(TreeViewer viewer, ITreeContentProvider provider, Object element) {
		if (isSrc(element)) {
			expandToFiles(viewer, provider, element);
			return true;
		}
		if (!isSearchable(element) || !provider.hasChildren(element)) {
			return false;
		}
		boolean found = false;
		for (Object child : provider.getChildren(element)) {
			found |= revealSrc(viewer, provider, child);
		}
		if (found) {
			viewer.expandToLevel(element, 1); // only the branch that leads to src
		}
		return found;
	}

	/** Files are left collapsed on purpose: expanding one would list its fields and methods. */
	private static void expandToFiles(TreeViewer viewer, ITreeContentProvider provider, Object element) {
		if (!provider.hasChildren(element)) {
			return;
		}
		viewer.expandToLevel(element, 1);
		for (Object child : provider.getChildren(element)) {
			if (!(child instanceof IFile || child instanceof ICompilationUnit)) {
				expandToFiles(viewer, provider, child);
			}
		}
	}

	private static boolean isSrc(Object element) {
		if (element instanceof IResource resource) {
			return SRC.equals(resource.getName());
		}
		return element instanceof IPackageFragmentRoot root && SRC.equals(root.getElementName());
	}

	/**
	 * Walk structure only: never into binary roots (the JRE container) or java packages, which is
	 * where a full model walk would spend all its time.
	 */
	private static boolean isSearchable(Object element) {
		if (element instanceof IFile || element instanceof ICompilationUnit || element instanceof IPackageFragment) {
			return false;
		}
		if (element instanceof IPackageFragmentRoot root) {
			try {
				return root.getKind() == IPackageFragmentRoot.K_SOURCE;
			} catch (JavaModelException e) {
				return false;
			}
		}
		return true; // IJavaProject, IProject, IFolder, working sets, JDT wrappers
	}

	private static String name(Object element) {
		return element == null ? "null" : element.getClass().getSimpleName() + "(" + element + ")";
	}

	private static String describe(ITreeContentProvider provider, Object[] elements) {
		StringBuilder text = new StringBuilder();
		for (Object element : elements) {
			text.append(name(element)).append(' ');
			for (Object child : provider.getChildren(element)) {
				text.append('>').append(name(child)).append(' ');
			}
		}
		return text.toString();
	}

	private static void log(String message) {
		Bundle bundle = Platform.getBundle("local.expand");
		if (bundle != null) {
			Platform.getLog(bundle).log(new Status(IStatus.INFO, "local.expand", message));
		}
	}
}
JAVA_EOF

"$JAVA/javac" --release 21 -nowarn -cp "$HOME/.p2/pool/plugins/*" -d "$BIN" "$BIN/local/expand/ExpandStartup.java"
"$JAVA/jar" --create --file "$OUT/local.expand_$VERSION.jar" --manifest "$BIN/META-INF/MANIFEST.MF" -C "$BIN" .
# A bundle without plugin.xml at its root installs fine, logs nothing and contributes nothing.
"$JAVA/jar" --list --file "$OUT/local.expand_$VERSION.jar" | grep -qx plugin.xml || {
	echo "eclipse-dropin: no plugin.xml at the jar root" >&2
	exit 1
}

mkdir -p "$INSTALL/dropins"
rm -f "$INSTALL/dropins"/local.expand_*.jar
cp "$OUT/local.expand_$VERSION.jar" "$INSTALL/dropins/"

# p2 rewrites bundles.info on its own, but only after resolving this one: keep the entry in
# sync so a version bump never leaves a dangling path behind.
if [ -f "$INFO" ] && grep -q '^local.expand,' "$INFO"; then
	sed -i.bak "s|^local.expand,.*|local.expand,$VERSION,../Eclipse/dropins/local.expand_$VERSION.jar,4,false|" "$INFO"
	rm -f "$INFO.bak"
fi

echo "eclipse-dropin: installed local.expand $VERSION into $INSTALL/dropins"
{{ end -}}
