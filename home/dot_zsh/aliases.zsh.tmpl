alias vim="nvim"
alias vi=vim
alias ivm="vim"
alias weather='curl -4 wttr.in/Zaragoza\?lang=es'
alias git-clean-local-branches="git branch -vv | grep -E \"desaparecido|gone\" | awk '{print $1}' | xargs -n1 git branch -d"
alias killNode="ps aux | grep ' node' | awk '{print $2}' | xargs kill"
alias grep='grep --color'
alias rg="rg --hidden"
alias fd="fd --hidden"
{{ if eq .chezmoi.os "darwin" }}alias cat="bat -p"{{ else }}alias cat="batcat -p"{{ end }}
{{ if eq .chezmoi.os "darwin" }}export MANPAGER="sh -c 'col -bx | bat -l man -p'"{{ else }}export MANPAGER="sh -c 'col -bx | batcat -l man -p'"{{ end }}
alias tmux="tmux -u"
alias k="kubectl"
alias python=python3
alias pip=pip3
alias hxraw='hx --config $HOME/.config/helix/config_raw.toml'
alias lg=lazygit
alias ls=eza
alias pass=pass-cli
{{ if eq .chezmoi.os "darwin" -}}
alias lockscreen='open -a ScreenSaverEngine'
alias kdiff3='/Applications/kdiff3.app/Contents/MacOS/kdiff3'
alias mergetool='git mergetool --tool kdiff3'
alias difftool='git difftool --tool kdiff3'
alias diff="diff-so-fancy"
alias zshspeed='sudo rm -rf /private/var/log/asl/*.asl'
alias agtop='npx github:ldegio/agtop'
{{ end -}}
{{ if .is_work }}alias sudo=doas{{ else }}unset AWS_PROFILE{{ end }}

function nave {
  local file=$(fzf --preview='cat {}' \
{{ if eq .chezmoi.os "darwin" -}}
				  --bind 'ctrl-o:execute-silent(open -R {})+abort')
{{ else -}}
				  )
{{ end }}
  [[ -n "$file" ]] || return

  if [[ ! -s "$file" ]] || [[ "$(file -b --mime-encoding "$file")" != "binary" ]]; then
	command $EDITOR "$file"
  else
{{ if eq .chezmoi.os "darwin" -}}
	open "$file"
{{ else -}}
	xdg-open "$file"
{{ end -}}
  fi
}
