export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
typeset -gU path

[ -f "$HOME/.zsh/zsh-private-config/init.zsh" ] && source "$HOME/.zsh/zsh-private-config/init.zsh"
autoload -Uz add-zsh-hook
_defer_plugins() {
  source $HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
  source $HOME/.zsh/zsh-history-substring-search/zsh-history-substring-search.zsh
  source $HOME/.zsh/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
  add-zsh-hook -d precmd _defer_plugins
  unfunction _defer_plugins
}
add-zsh-hook precmd _defer_plugins


bindkey -e

source $HOME/.zsh/aliases.zsh
source $HOME/.zsh/zoxide.zsh
source $HOME/.zsh/completions.zsh

autoload edit-command-line
zle -N edit-command-line
bindkey '^x^e' edit-command-line

HISTSIZE=100000000
SAVEHIST=100000000
HISTFILE=~/.zsh_history

ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=180'

setopt auto_cd #automatically cd to a directory without `cd`
setopt histignorealldups sharehistory

# Reset mouse tracking left over by TUI apps (opencode, herdr, etc.)
_reset_mouse_tracking() { printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l' > /dev/tty }
add-zsh-hook precmd _reset_mouse_tracking

export FZF_DEFAULT_COMMAND='rg --hidden --no-ignore -l ""'

PROMPT=$'%F{#7dcfff}%1~\n%f%B%b '

_prompt_git_branch() {
  local dir="${PWD/#$HOME/~}"
  if [[ $PWD != $_prompt_last_pwd ]]; then
    typeset -g _prompt_last_pwd=$PWD
    typeset -g _prompt_cached_branch
    _prompt_cached_branch=$(git symbolic-ref --short HEAD 2>/dev/null)
  fi
  if [[ -n $_prompt_cached_branch ]]; then
    PROMPT="%F{#7dcfff}${dir} %F{#bb9af7} ${_prompt_cached_branch}"$'\n%f%B%b '
  else
    PROMPT="%F{#7dcfff}${dir}"$'\n%f%B%b '
  fi
}
add-zsh-hook precmd _prompt_git_branch

true  # ensure .zshrc exits clean even if optional sources above failed
