{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/caffeine", "tray", "pulseaudio", "bluetooth", "network", "battery"],

  "hyprland/workspaces": {
    "on-click": "activate"
  },

  "hyprland/window": {
    "separate-outputs": true,
    "max-length": 45
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "bluetooth": {
    "format": "{icon}",
    "format-icons": { "enabled": "", "disabled": "" },
    "format-disabled": "",
    "format-off": "",
    "format-connected": "",
    "tooltip-format": "{controller_alias} · {controller_address}",
    "tooltip-format-connected": "{device_alias} · {device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifaddr}",
    "on-click": "ghostty --title=dotfloat -e netpanel",
    "on-click-right": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": { "default": ["", "", "", "", ""] },
    "on-click": "ghostty --title=dotfloat -e alsamixer",
    "on-click-right": "pamixer -t"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "{icon}",
    "format-icons": ["", "", "", "", ""],
    "on-click": "ghostty --title=dotfloat -e sudo powertop"
  },

  "custom/caffeine": {
    "format": "{}",
    "exec": "~/.config/hypr/caffeinate.sh icon",
    "return-type": "json",
    "signal": 8,
    "on-click": "~/.config/hypr/caffeinate.sh toggle; pkill -RTMIN+8 waybar"
  }
}
