#!/bin/sh
# herdr-plugins-hash: {{ joinPath .chezmoi.homeDir ".config/herdr/local-plugins/lazygit/herdr-plugin.toml" | include | sha256sum }}-{{ joinPath .chezmoi.homeDir ".config/herdr/local-plugins/nvim/herdr-plugin.toml" | include | sha256sum }}
command -v herdr >/dev/null 2>&1 || exit 0

for plugin in "$HOME/.config/herdr/local-plugins/lazygit" "$HOME/.config/herdr/local-plugins/nvim"; do
    [ -f "$plugin/herdr-plugin.toml" ] || continue
    herdr plugin unlink "$(grep '^id' "$plugin/herdr-plugin.toml" | head -1 | sed 's/.*= *"\(.*\)"/\1/')" >/dev/null 2>&1 || true
    herdr plugin link "$plugin" >/dev/null 2>&1
done
