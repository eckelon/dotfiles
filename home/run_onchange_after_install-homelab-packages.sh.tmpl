{{- if and .is_homelab (eq .chezmoi.os "linux") -}}
#!/bin/bash
# homelab-packages-hash: {{ "homelab-v1" | sha256sum }}
set -euo pipefail

echo "Installing homelab packages..."

sudo apt-get update -qq

sudo apt-get install -y -qq \
    zsh \
    git \
    curl \
    unzip \
    build-essential \
    bat \
    eza \
    zoxide \
    delta \
    neovim \
    jq \
    python3

# fd
if ! command -v fd >/dev/null 2>&1; then
    sudo apt-get install -y -qq fd-find
    sudo ln -sf "$(command -v fdfind)" /usr/local/bin/fd
fi

# ripgrep
if ! command -v rg >/dev/null 2>&1; then
    sudo apt-get install -y -qq ripgrep
fi

# fzf
if ! command -v fzf >/dev/null 2>&1; then
    sudo apt-get install -y -qq fzf
fi

# lazygit (not in apt, install from GitHub releases)
if ! command -v lazygit >/dev/null 2>&1; then
    LAZYGIT_VERSION=$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')
    curl -fsSL "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz" | sudo tar xzf - -C /usr/local/bin lazygit
fi

# herdr
if ! command -v herdr >/dev/null 2>&1; then
    curl -fsSL https://herdr.dev/install.sh | sh
fi

# pi
if ! command -v pi >/dev/null 2>&1; then
    curl -fsSL https://pi.dev/install.sh | sh
fi

# set zsh as default shell if it isn't already
if [ "$SHELL" != "$(command -v zsh)" ]; then
    sudo chsh -s "$(command -v zsh)" "$(whoami)"
fi

echo "Homelab packages installed."
{{ end -}}
