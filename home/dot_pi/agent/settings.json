{
  "$schema": "https://pi.dev/config.json",
  "compaction": {
    "enabled": true,
    "reserveTokens": 70000,
    "keepRecentTokens": 20000
  },
  "projectTrust": "ask",
  "defaultProjectTrust": "ask",
  "steeringMode": "one-at-a-time",
  "followUpMode": "all",
  "externalEditor": "nvim",
  "packages": [
    "npm:pi-mcp-adapter",
    {
      "source": "git:github.com/DietrichGebert/ponytail",
      "skills": [
        "!skills/ponytail-audit",
        "!skills/ponytail-debt",
        "!skills/ponytail-gain",
        "!skills/ponytail-help"
      ]
    },
    {
      "source": "npm:context-mode",
      "skills": ["!skills/ctx-*"]
    },
    {
      "source": "npm:pi-lens",
      "skills": ["!skills/pi-lens-write-*"]
    },
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:pi-safe-compact",
    "npm:@nguyenquangthai/pi-omp-theme"
  ],
  "lastChangelogVersion": "0.84.4",
  "defaultThinkingLevel": "max",
  "piOmpTheme": {
    "preset": "claude",
    "statusLine": {
      "layout": {
        "left": [
          "model_effort",
          "path",
          "git",
          "context_pct"
        ],
        "right": [],
        "secondary": []
      }
    }
  },
  "defaultProvider": "default",
  "defaultModel": "glm5.3-flash",
  "theme": "titanium",
  "images": {
    "blockImages": false
  },
  "hideThinkingBlock": true,
  "warnings": {
    "anthropicExtraUsage": true
  },
  "tuiMode": "fullscreen"
}
