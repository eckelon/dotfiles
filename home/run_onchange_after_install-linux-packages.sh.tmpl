{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# linux-packages-hash: {{ "linux-v6-keyd" | sha256sum }}
set -euo pipefail

echo "Installing Linux packages..."

if command -v pacman >/dev/null 2>&1; then
    # Arch (personal laptops): official repos + AUR via paru (walker launcher)
    sudo pacman -S --needed --noconfirm \
        zsh \
        git \
        curl \
        unzip \
        jq \
        python3 \
        eza \
        lazygit \
        bat \
        fd \
        ripgrep \
        fzf \
        zoxide \
        git-delta \
        neovim \
        blueman \
        imagemagick \
        keyd
    # keyd holds the keyboard layout (see dot_config/keyd/default.conf): it has
    # to run from boot, and the layout itself is pushed there by the
    # keyd-layout script. Ubuntu is keyboard-less (homelab), hence pacman only.
    sudo systemctl enable --now keyd
    # walker + elephant (AUR): launcher with clipboard history etc.
    # elephant-clipboard-bin needs a separate transaction: it depends on the
    # AUR source package 'elephant', which conflicts with elephant-bin when
    # both are resolved in one go.
    if command -v paru >/dev/null 2>&1; then
        paru -S --needed --noconfirm walker-bin elephant-bin elephant-desktopapplications-bin
        paru -S --needed --noconfirm elephant-clipboard-bin
        # installs + enables the systemd user unit (starts with the session)
        elephant service enable
    fi
else
    # Ubuntu (homelab): apt + GitHub builds for tools apt ships stale
    sudo apt-get update -qq

    sudo apt-get install -y -qq \
        zsh \
        git \
        curl \
        unzip \
        build-essential \
        bat \
        eza \
        zoxide \
        delta \
        jq \
        python3

# neovim (apt's 0.9 on Ubuntu 24.04 is ancient; install stable from GitHub)
# True when nvim is missing or older than 0.11 (min of [installed, 0.11] != 0.11).
NVIM_MIN="$(nvim --version 2>/dev/null | head -1 | grep -oE 'v[0-9.]+' | cut -c2- || true)"
if ! command -v nvim >/dev/null 2>&1 || [ "$(printf '%s\n0.11\n' "$NVIM_MIN" | sort -V | head -1)" != "0.11" ]; then
    NVIM_VERSION=$(curl -fsSL https://api.github.com/repos/neovim/neovim/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')
    curl -fsSL "https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/nvim-linux-x86_64.tar.gz" -o /tmp/nvim.tar.gz
    sudo tar xzf /tmp/nvim.tar.gz -C /opt nvim-linux-x86_64
    sudo ln -sf /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim
    rm -f /tmp/nvim.tar.gz
fi

# fd
if ! command -v fd >/dev/null 2>&1; then
    sudo apt-get install -y -qq fd-find
    sudo ln -sf "$(command -v fdfind)" /usr/local/bin/fd
fi

# ripgrep
if ! command -v rg >/dev/null 2>&1; then
    sudo apt-get install -y -qq ripgrep
fi

# fzf (apt's 0.44 on Ubuntu 24.04 predates `fzf --zsh`; install latest from GitHub)
# True when fzf is missing or older than 0.48 (min of [installed, 0.48] != 0.48).
FZF_MIN="$(fzf --version 2>/dev/null | awk '{print $1}' || true)"
if ! command -v fzf >/dev/null 2>&1 || [ "$(printf '%s\n0.48\n' "$FZF_MIN" | sort -V | head -1)" != "0.48" ]; then
    FZF_VERSION=$(curl -fsSL https://api.github.com/repos/junegunn/fzf/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')
    curl -fsSL "https://github.com/junegunn/fzf/releases/download/v${FZF_VERSION}/fzf-${FZF_VERSION}-linux_amd64.tar.gz" -o /tmp/fzf.tar.gz
    sudo tar xzf /tmp/fzf.tar.gz -C /usr/local/bin fzf
    rm -f /tmp/fzf.tar.gz
fi

    # nvm — installs to ~/.config/nvm (matches NVM_DIR in dot_zshrc).
    # Old setups used ~/.nvm; both work, but this is the canonical location.
    if [ ! -s "$HOME/.config/nvm/nvm.sh" ]; then
        curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.7/install.sh | NVM_DIR="$HOME/.config/nvm" bash
        # load nvm in this script so the install/alias below works
        export NVM_DIR="$HOME/.config/nvm"
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
        nvm install --lts
        nvm alias default node
    fi

    # lazygit (not in apt, install from GitHub releases)
    if ! command -v lazygit >/dev/null 2>&1; then
        LAZYGIT_VERSION=$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest | grep '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')
        curl -fsSL "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz" | sudo tar xzf - -C /usr/local/bin lazygit
    fi
fi

# herdr
if ! command -v herdr >/dev/null 2>&1; then
    curl -fsSL https://herdr.dev/install.sh | sh
fi

# pi
if ! command -v pi >/dev/null 2>&1; then
    curl -fsSL https://pi.dev/install.sh | sh
fi

# set zsh as default shell if it isn't already
if [ "$SHELL" != "$(command -v zsh)" ]; then
    sudo chsh -s "$(command -v zsh)" "$(whoami)"
fi

echo "Linux packages installed."
{{ end -}}