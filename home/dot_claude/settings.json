      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x '/Users/jesus.samitier/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/jesus.samitier/.orca/agent-hooks/claude-hook.sh'; fi",
            "timeout": 10
