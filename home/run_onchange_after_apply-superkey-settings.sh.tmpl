#!/bin/bash
# Apply Superkey plist settings (excluding license token and window frames)
# Run via chezmoi on change — auto-generated by capture-superkey-settings.sh

defaults write com.knollsoft.Superkey KeyboardShortcuts_toggleSeek -string '{"carbonModifiers":6912,"carbonKeyCode":1}'
defaults write com.knollsoft.Superkey SUEnableAutomaticChecks -int 0
defaults write com.knollsoft.Superkey capsHjklArrows -int 1
defaults write com.knollsoft.Superkey capsLockKeycode -int -1
defaults write com.knollsoft.Superkey capsLockRemapped -int 1
defaults write com.knollsoft.Superkey executeQuickHyperKey -int 1
defaults write com.knollsoft.Superkey hyperDeleteToForward -int 1
defaults write com.knollsoft.Superkey hyperFlags -int 1966080
defaults write com.knollsoft.Superkey keyRemap -int 1
defaults write com.knollsoft.Superkey launchOnLogin -int 1
defaults write com.knollsoft.Superkey minAxCharCount -int 2
defaults write com.knollsoft.Superkey physicalKeycode -int 231
defaults write com.knollsoft.Superkey quickHyperKeycode -int 53
defaults write com.knollsoft.Superkey seekOptions -int 3
